generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DOCTOR
  NURSE
  LAB
  PHARMACY
  RECEPTIONIST
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(RECEPTIONIST)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Patient {
  id Int @id @default(autoincrement())

  hospitalNumber String @unique

  firstName String
  lastName  String

  dateOfBirth DateTime

  gender Gender

  bloodGroup BloodGroup?

  phone String
  email String?

  address String

  maritalStatus MaritalStatus?

  emergencyName  String
  emergencyPhone String

  status PatientStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorId Int?
  doctor   Doctor? @relation(fields: [doctorId], references: [id])
}

enum Gender {
  MALE
  FEMALE
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum PatientStatus {
  ACTIVE
  DISCHARGED
  DECEASED
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  doctors Doctor[]
  nurses  Nurse[]
}

model Doctor {
  id             Int    @id @default(autoincrement())
  firstName      String
  lastName       String
  email          String @unique
  phone          String
  specialization String
  licenseNumber  String @unique

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patients Patient[]
}

model Nurse {
  id            Int    @id @default(autoincrement())
  firstName     String
  lastName      String
  email         String @unique
  phone         String
  licenseNumber String @unique

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
